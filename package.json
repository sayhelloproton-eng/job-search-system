{
  "name": "job-search-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app/server/server.ts",
    "demo": "node app/server/server.ts --demo",
    "interview:runtime": "node app/server/interview-runtime-cli.ts",
    "interview:host": "node app/server/interview-runtime-host.ts",
    "test": "node scripts/run-public-tests.mjs",
    "test:local": "node --test --test-concurrency=1 app/tests/*.test.ts",
    "verify:public": "node scripts/public-check.mjs && node scripts/run-public-tests.mjs"
  }
}
